[Unit]
Description=OmniRoute Antigravity Bridge Proxy
After=network.target omniroute.service
Wants=omniroute.service

[Service]
Type=simple
WorkingDirectory=%h/omniroute
Environment=BRIDGE_PORT=20129
Environment=ROUTER_URL=http://127.0.0.1:20128/v1/antigravity
EnvironmentFile=-%h/.omniroute/.env
ExecStart=/usr/bin/env node bin/antigravity-bridge.mjs
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=default.target
